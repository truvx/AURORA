<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext traffic to the Android emulator localhost proxy (10.0.2.2) for debug builds only.
         This permits the AURORA AI gateway calls to reach the local Next.js dev server. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
