<?xml version="1.0" encoding="utf-8"?>
<!--
  The AURORA mark: five bars of a level meter, rising and falling.

  Drawn as a vector rather than shipped as bitmaps because it is pure geometry - there is
  nothing for a PNG to add at any density, and minSdk is 26, so every install supports
  adaptive icons.

  The 108dp canvas has a 72dp safe zone at its centre; masks on different launchers eat the
  rest. Everything here stays inside roughly 60dp so no launcher shape clips a bar.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="#6A98FF"
        android:pathData="M30,46 h6 a3,3 0 0 1 3,3 v10 a3,3 0 0 1 -3,3 h-6 a3,3 0 0 1 -3,-3 v-10 a3,3 0 0 1 3,-3 z" />
    <path
        android:fillColor="#6A98FF"
        android:pathData="M42,38 h6 a3,3 0 0 1 3,3 v26 a3,3 0 0 1 -3,3 h-6 a3,3 0 0 1 -3,-3 v-26 a3,3 0 0 1 3,-3 z" />
    <path
        android:fillColor="#28A4FE"
        android:pathData="M54,30 h6 a3,3 0 0 1 3,3 v42 a3,3 0 0 1 -3,3 h-6 a3,3 0 0 1 -3,-3 v-42 a3,3 0 0 1 3,-3 z" />
    <path
        android:fillColor="#6A98FF"
        android:pathData="M66,40 h6 a3,3 0 0 1 3,3 v22 a3,3 0 0 1 -3,3 h-6 a3,3 0 0 1 -3,-3 v-22 a3,3 0 0 1 3,-3 z" />
    <path
        android:fillColor="#6A98FF"
        android:pathData="M78,48 h6 a3,3 0 0 1 3,3 v6 a3,3 0 0 1 -3,3 h-6 a3,3 0 0 1 -3,-3 v-6 a3,3 0 0 1 3,-3 z" />
</vector>
