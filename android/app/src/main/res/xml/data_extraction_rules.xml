<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 and above, where backup and device transfer are separate decisions.

  Cloud backup gets the same exclusions as backup_rules.xml: listening history does not
  go to a Google account.

  Device transfer is different and treated differently. It is a direct, person-initiated
  move to their next phone with nothing left behind on a server, so the library and its
  history travel - losing years of listening history when changing phones would be the
  worse failure. Only the secrets are held back, because the Keystore key that decrypts
  them cannot move with them.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="aurora-database" />
        <exclude domain="database" path="aurora-database-wal" />
        <exclude domain="database" path="aurora-database-shm" />
        <exclude domain="sharedpref" path="aurora_secure.xml" />
        <exclude domain="sharedpref" path="aurora_discovery.xml" />
        <exclude domain="file" path="profile_photo.jpg" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="aurora_secure.xml" />
        <exclude domain="sharedpref" path="aurora_discovery.xml" />
    </device-transfer>
</data-extraction-rules>
