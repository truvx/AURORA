{
  "$schema": "https://aurora.dev/schemas/design-tokens/spacing.json",
  "version": "1.0.0",
  "description": "AURORA canonical spacing tokens. 4-unit rhythm. Reference contract for cross-platform parity.",
  "unit": "dp/px",
  "base": 4,
  "scale": {
    "space1": 4,
    "space2": 8,
    "space3": 12,
    "space4": 16,
    "space5": 20,
    "space6": 24,
    "space8": 32,
    "space10": 40,
    "space12": 48,
    "space16": 64
  },
  "shape": {
    "control": 12,
    "card": 20,
    "sheet": 28,
    "dialog": 24,
    "artwork": 16
  },
  "touchTarget": {
    "android": 48,
    "web": 44
  }
}
