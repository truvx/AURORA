# AI Gateway configuration
# Provide keys for the models you intend to use.
GEMINI_API_KEY="your_gemini_api_key_here"
OPENAI_API_KEY="your_openai_api_key_here"

# Access token every client must send as "Authorization: Bearer <token>".
# Without it the gateway refuses all requests rather than running open. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# then paste the same value into the Android app under Settings > AI gateway.
AURORA_GATEWAY_TOKEN=""
